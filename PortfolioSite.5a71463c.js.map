    var base = state.deltaBase + (b - 1) * 16;
    var ds = state.deltaShift;
    if (exports.DEBUG) console.log(state.step, 'DELTAC[' + b + ']', n, stack);
    for(var i = 0; i < n; i++){
        var c = stack.pop();
